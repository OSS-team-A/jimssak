# From backend/: copy .env.example to .env to override the defaults.
AUTH_SESSION_TTL_SECONDS=86400
# Maximum refresh lifetime from login, in seconds (14 days).
AUTH_REFRESH_TTL_SECONDS=1209600
# Relative paths are resolved from backend/. Moves are stored in the same database.
AUTH_DB_PATH=data/auth.sqlite3
# A guest move stays open for this many seconds after its last request (24 hours).
GUEST_MOVE_TTL_SECONDS=86400
