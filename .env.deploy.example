# Server settings for docker compose. Copy to .env.deploy on the server and fill in.
# .env.deploy is ignored by git; never commit real keys.

# Frontend address(es) allowed to call the API: JSON array, no trailing slash.
CORS_ORIGINS=["https://your-frontend.example.com"]

# 행정안전부 주소 검색 승인키. Empty: address search answers 503.
ADDRESS_SEARCH_API_KEY=
# 공공데이터포털 일반 인증키(Decoding): 건축물대장, 공휴일·손없는 날.
DATA_GO_KR_SERVICE_KEY=
# 카카오 REST API 키: 주소 좌표와 자동차 거리.
KAKAO_REST_API_KEY=

# Until the AI analyzer is connected, finish every upload with a sample result (marked demo).
ANALYSIS_DEMO=true
# Shared key for the AI analyzer on /api/v1/internal/analyses. Empty: that API is off.
ANALYSIS_WORKER_KEY=
